APP_NAME=Employee AI Service
APP_VERSION=1.0.0
ENVIRONMENT=development

#LLM settings
LLM_PROVIDER=ollama

#ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b



# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379


# Postgres settings from Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=****
POSTGRES_DB=employee_ai

#JWT 
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=


#
LLM_CONTEXT_WINDOW=
LLM_MAX_OUTPUT_TOKENS=

#limit for relevant messages to retrieve
RELEVANT_MESSAGE_LIMIT=3


#embedding model 
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B